[global]
monitor = 0
follow = mouse

width = (300, 360)
height = (70, 220)

origin = top-right
offset = (20, 20)

scale = 0
notification_limit = 4

indicate_hidden = yes
transparency = 12

corner_radius = 18
gap_size = 10

separator_height = 0
separator_color = "auto"

padding = 16
horizontal_padding = 18
text_icon_padding = 14

frame_width = 1
frame_color = "#45475A"

sort = yes
idle_threshold = 120

font = SF Pro Display Medium 10

line_height = 2

markup = full
format = "<span weight='bold' size='105%%'>%s</span>\n<span size='95%%'>%b</span>"

alignment = left 
vertical_alignment = center

show_age_threshold = 60

ellipsize = end
ignore_newline = no

stack_duplicates = true
hide_duplicate_count = false

show_indicators = no

enable_recursive_icon_lookup = true
icon_theme = "Papirus-Dark, Adwaita"

icon_position = left

min_icon_size = 32
max_icon_size = 42

icon_corner_radius = 10

sticky_history = yes
history_length = 30

browser = /usr/bin/xdg-open

always_run_script = true
ignore_dbusclose = false
force_xinerama = false

mouse_left_click = do_action, close_current
mouse_middle_click = close_current
mouse_right_click = close_all

progress_bar = true
progress_bar_height = 6

progress_bar_frame_width = 0

progress_bar_min_width = 120
progress_bar_max_width = 260

progress_bar_corner_radius = 3 

title = Dunst
class = Dunst


[urgency_low]
timeout = 3

background = "#1E1E2ECC"
foreground = "#A6E3A1"

highlight = "#A6E3A1"


[urgency_normal]
timeout = 5

background = "#1E1E2ECC"
foreground = "#CDD6F4"

highlight = "#89B4FA"


[urgency_critical]
timeout = 0

background = "#1E1E2ECC"
foreground = "#F38BA8"

highlight = "#F38BA8"

{
    "layer": "top",
    "position": "top",
    "spacing": 12,
    "margin": 14,

    "modules-left": ["custom/launcher", "cpu", "memory", "disk", "custom/brightness"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["pulseaudio", "network", "battery", "clock", "tray"],

    "hyprland/workspaces": {
        "on-scroll-up": "hyprctl dispatch workspace r-1",
        "on-scroll-down": "hyprctl dispatch workspace r+1",
        "all-outputs": true,
        "active-only": false,
        "format": "{icon}",
        "cursor": true,
        "persistent-workspaces": {
            "*": 8
        },
        "format-icons": {
            "active": "󰮯",
            "default": "󰊠",
            "empty": "󰑊"
        }
    },

    "clock": {
        "interval": 1,

        "format": "   {:%I:%M %p}",
        "format-alt": "   {:%A, %d %B %Y}",

        "tooltip-format": "<tt>{calendar}</tt>",

        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,

            "format": {
                "months": "<span color='#B4BEFE'><b>{}</b></span>",
                "weekdays": "<span color='#A6ADC8'><b>{}</b></span>",
                "days": "<span color='#CDD6F4'>{}</span>",
                "weeks": "<span color='#6C7086'><b>W{}</b></span>",
                "today": "<span color='#F38BA8'><b>{}</b></span>"
            }
        },

        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        },

        "on-click": "mode"
    },

    "cpu": {
        "interval": 2,
        "format": "   {usage}%"
    },

    "memory": {
        "interval": 5,
        "format": "   {used:0.1f}G"
    },

    "disk": {
        "interval": 30,
        "format": "   {used}",
        "path": "/"
    },

    "network": {
        "interval": 1,

        "format-wifi": "󰤨   {essid}  {bandwidthDownBytes}",
        "format-ethernet": "󰈀   {bandwidthDownBytes}",
        "format-disconnected": "󰤮",

        "tooltip-format": "{ipaddr}",

        "on-click": "$HOME/.config/hypr/scripts/open-apps --netmanager"
    },

    "pulseaudio": {
        "format": "{icon}   {volume}%",
        "format-muted": "󰖁   Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-scroll-up": "$HOME/.config/hypr/scripts/volume --inc",
        "on-scroll-down": "$HOME/.config/hypr/scripts/volume --dec",
        "on-click": "$HOME/.config/hypr/scripts/volume --toggle",
        "on-click-right": "$HOME/.config/hypr/scripts/open-apps --soundcontrol"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon}   {capacity}%",
        "format-charging": "󰂄   {capacity}%",
        "format-plugged": "󰚥   {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "custom/brightness": {
        "exec": "brightnessctl i | awk -F '[()%]' '/Current/{print $2}'",
        "interval": 1,
        "format": "󰃠   {}%",
        "on-scroll-up": "$HOME/.config/hypr/scripts/brightness up",
        "on-scroll-down": "$HOME/.config/hypr/scripts/brightness down",
        "on-click": "$HOME/.config/hypr/scripts/brightness up"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    "custom/launcher": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "$HOME/.config/hypr/scripts/open-apps --menu"
    }
}
